{
	"name": "ferma-support-portal-client",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"prepare": "husky",
		"lint": "eslint --fix \"{,!(node_modules|public|dist)/**/}*.{js,svelte}\"",
		"format": "npx prettier --write \"{,!(node_modules|public|dist)/**/}*.{js,svelte,scss,css}\"",
		"preview": "vite preview",
		"dev": "vite --config config/vite.config.js --host",
		"build": "vite --config config/vite.config.js build"
	},
	"devDependencies": {
		"@eslint/js": "^9.20.0",
		"@smui/data-table": "7.0.0-beta.16",
		"@sveltejs/vite-plugin-svelte": "^3.0.2",
		"autoprefixer": "^10.4.18",
		"eslint": "^9.18.0",
		"eslint-plugin-svelte": "^2.46.1",
		"globals": "^15.15.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.4.3",
		"postcss": "^8.4.49",
		"postcss-load-config": "^5.0.3",
		"postcss-normalize": "^10.0.1",
		"postcss-preset-env": "^9.4.0",
		"prettier": "^3.2.5",
		"prettier-plugin-svelte": "^3.2.2",
		"sass": "^1.71.1",
		"svelte": "^4.2.19",
		"svelte-dnd-action": "^0.9.50",
		"svelte-eslint-parser": "^0.33.1",
		"svelte-preprocess": "^5.1.3",
		"vite": "^5.3.6"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@azure/msal-browser": "^4.2.0",
		"@material/icon-button": "^14.0.0",
		"@smui/icon-button": "^7.0.0",
		"@tanstack/svelte-table": "^8.20.5",
		"casbin": "^5.30.0",
		"casbin.js": "^0.5.1",
		"diff": "^5.2.0",
		"svelte-select": "^5.8.3",
		"svelte-spa-router": "^4.0.1"
	},
	"overrides": {
		"axios": "0.28.0"
	},
	"lint-staged": {
		"**/*.*": [
			"prettier --write"
		],
		"**/*.{js,svelte}": [
			"eslint --fix"
		]
	}
}
